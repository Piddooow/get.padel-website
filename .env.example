# ---------------------------------------------------------------------------
# Get Padel Jakarta — environment template (copy to .env.local, never commit)
# ---------------------------------------------------------------------------

# Real-time court availability (official AYO venue channel).
# Without these the schedule pages show an honest "not connected" notice and
# never invent slots.
AYO_AVAILABILITY_API_URL=
AYO_AVAILABILITY_API_TOKEN=
# Token that protects POST /api/availability/sync (manual/cron refresh).
AYO_SYNC_TOKEN=
# Optional: how long a sync stays trustworthy (minutes, default 15).
AYO_AVAILABILITY_MAX_AGE_MINUTES=15

# Midtrans payments (official Snap API). Get the keys from the Midtrans
# dashboard. Without MIDTRANS_SERVER_KEY the booking page falls back to the
# official AYO / WhatsApp channels instead of taking payments.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_EXPIRY_MINUTES=15

# Hosted database (Turso / libSQL) — required on serverless platforms such as
# Vercel so accounts and bookings persist. Create a database at turso.tech and
# set both values, then run `npm run db:migrate` once against it.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin panel access.
ADMIN_TOKEN=

# Optional: legacy HMAC secret for the pre-Midtrans handoff webhook.
PAYMENT_WEBHOOK_SECRET=

# Google Analytics 4 (optional; only loads after cookie consent).
NEXT_PUBLIC_GA4_ID=
